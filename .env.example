# Copy this file to .env (in the repo root) and fill in the values.
# .env is git-ignored. Share real keys with each other privately, never in the repo.

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs (Sakshi's /api/alert) -> https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tiger Data (Timescale cloud Postgres). Leave empty to skip logging.
DATABASE_URL=

# Comma-separated list of front-end origins allowed to call the API ("*" = any)
CORS_ORIGINS=*

# Brightness threshold (0-255) for window detection
DETECT_THRESHOLD=200
